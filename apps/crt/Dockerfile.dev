# Stage 1: Build (if you need a separate builder image)
FROM node:22.18.0 AS builder
WORKDIR /app
COPY package*.json ./
COPY pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile
COPY . .
# Do NOT run the build here if you want to ensure version sync.

# Stage 2: Final Image
FROM nginx:alpine AS stage-1
WORKDIR /app

# Copy source and dependencies
COPY --from=builder /app ./

# Install (if needed, or use builder stage output)
# RUN npm install -g pnpm && pnpm install --frozen-lockfile

# Run the build and inject version in sequence
RUN NX_VERSION=$(jq -r .version package.json) && \
    echo "Building with version: $$NX_VERSION" && \
    nx run crt:build:production --base-href=/crt/ && \
    node script/inject-version.js crt

# Copy the final built assets to nginx
COPY --from=stage-1 /app/dist/apps/crt /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf
