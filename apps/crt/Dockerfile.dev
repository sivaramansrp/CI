# apps/<app>/Dockerfile.dev
FROM nginx:alpine-slim AS runner

# Remove default config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom nginx config (must exist)
COPY apps/${APP_NAME}/nginx.conf /etc/nginx/conf.d/app.conf

# Copy pre-built app from host
COPY dist/apps/${APP_NAME} /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/${APP_NAME}/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
