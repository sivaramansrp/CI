# Dockerfile for building and serving the Angular crt application.

# - Stage 1: Build the Angular app -
FROM node:22-slim AS node

WORKDIR /app

# Copy dependency configuration files first
COPY package*.json ./
COPY pnpm-lock.yaml ./  # Remove this line if you don't use pnpm

# Copy scripts directory (needed for postinstall/versioning)
COPY script ./script

# Install dependencies
# If using pnpm:
# RUN npm install -g pnpm && \
#     mkdir -p /pnpm-global && \
#     pnpm config set prefix "/pnpm-global/bin" && \
#     export PNPM_HOME=/pnpm-global/bin && \
#     export PATH=$PNPM_HOME:$PATH && \
#     pnpm add -g nx && \
#     pnpm install --no-lockfile && \
#     pnpm add webpack@5.91.0

# ✅ Use npm instead (since your build failed with pnpm)
RUN npm install -g nx && \
    npm ci && \
    npm install webpack@5.91.0 --save-dev

# Copy the application source code
COPY apps ./apps
COPY libs ./libs
COPY apps/crt/src ./src

# Enable verbose logging for Nx
ENV NX_VERBOSE_LOGGING=true

ARG NODE_ENV
RUN echo "Building crt image for environment: $NODE_ENV"
RUN npx nx build crt --configuration=$NODE_ENV --base-href=/crt/ --skip-nx-cache --verbose

# Inject version into built index.html
RUN node script/inject-version.js crt

# - Stage 2: Serve with Nginx -
FROM nginx:alpine-slim

# Copy custom Nginx configuration for the crt app
COPY apps/crt/nginx.conf /etc/nginx/conf.d/crt.conf

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy the built crt application from Stage 1 to the Nginx-served directory
COPY --from=node /app/dist/apps/crt /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/crt/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
