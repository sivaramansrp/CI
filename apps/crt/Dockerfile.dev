# apps/crt/Dockerfile.dev
FROM nginx:alpine-slim AS runner

RUN rm -rf /etc/nginx/conf.d/default.conf
COPY apps/crt/nginx.conf /etc/nginx/conf.d/crt.conf

# Copies the latest built files from the host (CI runner)
COPY dist/apps/crt /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/crt/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
