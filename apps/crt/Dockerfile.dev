# === STAGE 1: Build with Node ===
FROM node:22-slim AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml ./

# Install pnpm
RUN npm install -g pnpm

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the app
ARG NODE_ENV=development
RUN echo "Building crt image for environment: $NODE_ENV"
RUN npx nx build crt --configuration=$NODE_ENV --base-href=/crt/ --skip-nx-cache

# Optional: Inject version into index.html
# Assumes script/inject-version.js exists
ENV VERSION=${VERSION:-"unknown"}
RUN node script/inject-version.js crt

# === STAGE 2: Serve with Nginx ===
FROM nginx:alpine-slim AS stage-1

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY apps/crt/nginx.conf /etc/nginx/conf.d/crt.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist/apps/crt /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/crt/ || exit 1

# Default command
CMD ["nginx", "-g", "daemon off;"]
