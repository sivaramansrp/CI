# Dockerfile for building and serving Angular micro-frontend app

# - Stage 1: Build the app -
FROM node:22-slim AS node

WORKDIR /app

# Copy dependency files
COPY package*.json ./


# Copy version injection script
COPY script ./script

# Install dependencies
RUN npm install -g pnpm && \
    mkdir -p /pnpm-global && \
    pnpm config set prefix "/pnpm-global/bin" && \
    export PNPM_HOME=/pnpm-global/bin && \
    export PATH=$PNPM_HOME:$PATH && \
    pnpm add -g nx && \
    pnpm install --no-lockfile && \
    pnpm add webpack@5.91.0 --save-dev

# Copy source code
COPY apps ./apps
COPY libs ./libs
# Copy only the target app's src (critical for Nx)
COPY apps/${APP_NAME}/src ./src

# Enable verbose logging
ENV NX_VERBOSE_LOGGING=true

# Build the app
ARG NODE_ENV=production
ARG APP_NAME
RUN echo "Building $APP_NAME image for environment: $NODE_ENV"
RUN npx nx build $APP_NAME --configuration=$NODE_ENV --base-href=/${APP_NAME}/ --skip-nx-cache --verbose

# Inject version into index.html
RUN node script/inject-version.js $APP_NAME

# - Stage 2: Serve with Nginx -
FROM nginx:alpine-slim

# Remove default config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY apps/${APP_NAME}/nginx.conf /etc/nginx/conf.d/app.conf

# Copy built assets from builder stage
COPY --from=node /app/dist/apps/${APP_NAME} /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/${APP_NAME}/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
