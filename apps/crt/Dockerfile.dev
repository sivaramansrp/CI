# apps/crt/Dockerfile.dev
# Build and serve CRT app (same strategy as profepa)

# - Stage 1: Build with Node -
FROM node:22-slim AS node

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml ./

# Copy scripts
COPY script ./script

# Install pnpm and dependencies
RUN npm install -g pnpm && \
    mkdir -p /pnpm-global && \
    pnpm config set prefix "/pnpm-global/bin" && \
    export PNPM_HOME=/pnpm-global/bin && \
    export PATH=$PNPM_HOME:$PATH && \
    pnpm add -g nx && \
    pnpm install --no-lockfile && \
    pnpm add webpack@5.91.0 --save-dev

# Copy source code
COPY apps ./apps
COPY libs ./libs
COPY apps/crt/src ./src

# Enable verbose logging
ENV NX_VERBOSE_LOGGING=true

# Build the app
ARG NODE_ENV=production
RUN echo "Building crt image for environment: $NODE_ENV"
RUN npx nx build crt --configuration=$NODE_ENV --base-href=/crt/ --skip-nx-cache --verbose

# Inject version
RUN node script/inject-version.js crt

# - Stage 2: Serve with Nginx -
FROM nginx:alpine-slim

# Remove default config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY apps/crt/nginx.conf /etc/nginx/conf.d/crt.conf

# Copy built assets from builder
COPY --from=node /app/dist/apps/crt /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/crt/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
