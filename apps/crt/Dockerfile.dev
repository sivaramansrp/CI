# Dockerfile for building and serving the CRT app
# Uses npm instead of pnpm (since pnpm-lock.yaml is missing)

# - Stage 1: Build with Node -
FROM node:22-slim AS node

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies using npm
RUN npm ci --silent

# Copy scripts (for version injection)
COPY script ./script

# Copy source code
COPY apps ./apps
COPY libs ./libs
# Copy only the target app's src
COPY apps/crt/src ./src

# Build the app
ARG NODE_ENV=production
RUN echo "Building crt image for environment: $NODE_ENV"
RUN npx nx build crt --configuration=$NODE_ENV --base-href=/crt/ --skip-nx-cache --verbose

# Inject version into index.html
RUN node script/inject-version.js crt

# - Stage 2: Serve with Nginx -
FROM nginx:alpine-slim

# Remove default config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY apps/crt/nginx.conf /etc/nginx/conf.d/crt.conf

# Copy built assets from builder
COPY --from=node /app/dist/apps/crt /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost/crt/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
