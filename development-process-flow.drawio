          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-39" value="Once the increment is deployed, the team presents its functionality to the PO in the &quot;Review&quot; ceremony, indicating how each acceptance criterion was met" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
