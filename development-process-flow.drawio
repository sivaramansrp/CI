    <mxGraphModel dx="1315" dy="871" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-2" target="0is0kIDA_ZpxFRgXgKSO-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-2" value="Someone, (usually the PO) creates a Github Issue in the Project Kanban board (if possible, with acceptance criteria) with a short and descriptive name prefixed with feature, or bugfix or any applicable indicator and a brief description and places it in the PBL at any time during the sprint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-4" target="0is0kIDA_ZpxFRgXgKSO-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-4" value="During the &quot;Grooming&quot; ceremony, the PO prioritizes the most relevant Issues for the upcoming sprint and leaves the PBL &quot;prioritized&quot;, with the help of the team." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="360" y="40" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-6" target="0is0kIDA_ZpxFRgXgKSO-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-6" value="In the &quot;Planning&quot; ceremony:&lt;div&gt;- The team selects the Issues they will commit to deliver by the end of the sprint.&lt;/div&gt;&lt;div&gt;- Their weight (in any relative points, like story points, for example) is calculated using poker or silent groups technique.&lt;/div&gt;&lt;div&gt;- Issues are assigned (or self-assigned) to the team&lt;/div&gt;&lt;div&gt;- The RSP (Release Schedule Plan) is rebalanced&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="680" y="40" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-8" target="0is0kIDA_ZpxFRgXgKSO-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-8" value="&lt;div&gt;Each developer (f&lt;span style=&quot;background-color: initial;&quot;&gt;or each of their Issues&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;) creates a GIT branch (feature/bugfix/hotfix) from the Kanban proyect board&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="280" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-10" target="0is0kIDA_ZpxFRgXgKSO-13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-10" value="&lt;div&gt;THE DAILY STANDUP MEETING CEREMONY IS HELD EVERY DAY AND IS LED BY THE SM&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="360" y="280" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-4" target="0is0kIDA_ZpxFRgXgKSO-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-13" target="0is0kIDA_ZpxFRgXgKSO-15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-13" value="&lt;div&gt;The developer clones the branch created in Github in his local machine&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="280" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-15" target="0is0kIDA_ZpxFRgXgKSO-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-15" value="&lt;div&gt;The developer codes, aiming to meet the acceptance criteria of the Issue according to the DoD, makes integral commits, and finally pushes their branch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-17" target="0is0kIDA_ZpxFRgXgKSO-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-17" value="&lt;div&gt;The developer creates/edits a PR with at least 2 reviewers and sends review invitations to their co-workers.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="440" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-19" target="0is0kIDA_ZpxFRgXgKSO-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-19" value="&lt;div&gt;The PR reviewers review the code and, if necessary, generate observations for the PR creator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="440" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-20" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-22" target="0is0kIDA_ZpxFRgXgKSO-24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-21" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-22" target="0is0kIDA_ZpxFRgXgKSO-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-22" value="&amp;nbsp;Were there&amp;nbsp;&lt;div&gt;any observations?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="750" y="630" width="140" height="140" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-24" target="0is0kIDA_ZpxFRgXgKSO-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-24" value="The developer addresses the observations / justifies their implementation / addresses the findings of the CI/CD" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="640" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-26" target="0is0kIDA_ZpxFRgXgKSO-28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-26" value="The reviewers (at least 2) approve the PR" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="640" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-28" target="0is0kIDA_ZpxFRgXgKSO-30" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-28" value="The developer merges his/her code into the &quot;develop&quot; branch&amp;nbsp;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="440" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-30" target="0is0kIDA_ZpxFRgXgKSO-32" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-30" value="The system initiates the continuous integration and continuous deployment pipeline" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="280" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-32" target="0is0kIDA_ZpxFRgXgKSO-34" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-32" value="The system invokes the CI/CD pipeline:&amp;nbsp;&lt;div&gt;- creates the binary,&amp;nbsp;&lt;div&gt;- runs unit tests,&amp;nbsp;&lt;/div&gt;&lt;div&gt;- calculates coverage (80% minimum),&amp;nbsp;&lt;/div&gt;&lt;div&gt;-&amp;nbsp; validates&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;adherence to standards&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- reports code-smells&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- detects security issues&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- creates container&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- saves image&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="40" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-33" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0is0kIDA_ZpxFRgXgKSO-34" target="0is0kIDA_ZpxFRgXgKSO-37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0is0kIDA_ZpxFRgXgKSO-34" value="Did the system&lt;div&gt;&amp;nbsp;detect any&amp;nbsp;&lt;/div&gt;&lt;div&gt;issues?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
