        <mxCell id="0is0kIDA_ZpxFRgXgKSO-37" value="The system invokes the deployment procedure in the appropriate pre-production environment (DEV, QA, or UAT)" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1560" y="40" width="200" height="160" as="geometry" />
