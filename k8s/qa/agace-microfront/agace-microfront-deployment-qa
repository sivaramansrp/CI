apiVersion: apps/v1
kind: Deployment
metadata:
  name: modulefederation-agace-microfront-deployment-qa
spec:
  replicas: 1
  selector:
    matchLabels:
      app: modulefederation-agace-microfront-qa
  template:
    metadata:
      labels:
        app: modulefederation-agace-microfront-qa
    spec:
      containers:
      - name: front-vucem30-container-dev
        image: ghcr.io/vucem30/dockerized-modulefederation-agace-microfront:1.0.34
        ports:
        - containerPort: 80
        env:
        - name: SPRING_PROFILES_ACTIVE
          value: qa
      imagePullSecrets:
      - name: vucem30registrykey
